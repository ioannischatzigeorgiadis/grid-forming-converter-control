        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "DirectFeedthrough"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Ts"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "TerminalBasedSampleTimes"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "Parameters"
        Value         "Ts, ac, wb, Lb"
        Show          off
      }
      Parameter {
        Variable      "LangStandard"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "GnuExtensions"
        Value         "1"
        Show          off
      }
      Parameter {
        Variable      "RuntimeCheck"
        Value         "2"
        Show          off
      }
      Parameter {
        Variable      "HighlightLevel"
        Value         "0"
        Show          off
      }
      Parameter {
        Variable      "Declarations"
        Value         "#include <stdio.h>\n"
"#include <stdlib.h>\n"
"#include <float.h>\n"
"#include <math.h>\n"
"\n"
"// Static variable\n"
"//int sizeA, numRowsB;\n"
"//int outIdxC, outIdxD;\n"
"float kp,ki,errord,errorq,Rest,Lest;\n"
"float Ts, ac, wb, Lb, dblk;\n"
"float idref, iqref, id, iq, ud, uq, ww;"
        Show          off
      }
      Parameter {
        Variable      "StartFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "OutputFcn"
        Value         "//OutputSignal(0, 0) = DiscState(0) + 2.*InputSignal(0,"
" 0);\n"
"id = InputSignal(0, 0);\n"
"iq = InputSignal(0, 1);\n"
"idref = InputSignal(0, 2);\n"
"iqref = InputSignal(0, 3);\n"
"dblk = InputSignal(0, 4);\n"
"ud = InputSignal(0, 5);\n"
"uq = InputSignal(0, 6);\n"
"ww = InputSignal(0, 7);\n"
"\n"
"Ts = ParamRealData(0, 0);\n"
"ac = ParamRealData(1, 0);\n"
"wb = ParamRealData(2, 0);\n"
"Lb = ParamRealData(3, 0);\n"
"\n"
"Lest = 0.15f*Lb;\n"
"kp = ac*Lest;\n"
"errord = idref-id;\n"
"errorq = iqref-iq;\n"
"\n"
"if (dblk == 0 ) {\n"
"    OutputSignal(0, 0) = ud; \n"
"    OutputSignal(0, 1) = uq;\n"
"} else {\n"
"    OutputSignal(0, 0) = kp*errord + DiscState(0) - ww*Lest*iqref + ud; \n"
"    OutputSignal(0, 1) = kp*errorq + DiscState(1) + ww*Lest*idref + uq;\n"
"}\n"
"\n"
"//OutputSignal(0, 0) = kp*errord + DiscState(0) + wb*Lest*iqref + ud; \n"
"//OutputSignal(0, 1) = kp*errorq + DiscState(1) - wb*Lest*idref + uq;"
        Show          off
      }
      Parameter {
        Variable      "UpdateFcn"
        Value         "//DiscState(0) = InputSignal(0, 0);\n"
"id = InputSignal(0, 0);\n"
"iq = InputSignal(0, 1);\n"
"idref = InputSignal(0, 2);\n"
"iqref = InputSignal(0, 3);\n"
"dblk = InputSignal(0, 4);\n"
"\n"
"Ts = ParamRealData(0, 0);\n"
"ac = ParamRealData(1, 0);\n"
"\n"
"Rest = 4.225;\n"
"ki = ac*Rest;\n"
"errord = idref-id;\n"
"errorq = iqref-iq;\n"
"\n"
"if (dblk == 0 ) {\n"
"    DiscState(0) += 0; \n"
"    DiscState(1) += 0;\n"
"} else {\n"
"    DiscState(0) += ki*errord*Ts; \n"
"    DiscState(1) += ki*errorq*Ts;\n"
"}"
        Show          off
      }
      Parameter {
        Variable      "DerivativeFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "TerminateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "StoreCustomStateFcn"
        Value         ""
        Show          off
      }
      Parameter {
        Variable      "RestoreCustomStateFcn"
        Value         ""
        Show          off
      }
